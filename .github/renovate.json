{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "enabledManagers": [
    "nix",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [],
    "automerge": true
  },
  "ignorePaths": [
    "**/hydenix-themes/**",
    "**/template/**",
    "**/demo/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "depTypeTemplate": "nix-raw-pkgs",
      "managerFilePatterns": [
        "/^pkgs\/.*\\.nix$/"
      ],
      "matchStrings": [
        "fetchFromGitHub\\s*{[^}]*owner = \"(?<depOwner>[^\"]+)\";[^}]*repo = \"(?<depRepo>[^\"]+)\";[^}]*rev = \"(?<currentValue>[^\"]+)\";"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{depOwner}}/{{depRepo}}",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "depTypeTemplate": "nix-flake-inputs",
      "managerFilePatterns": [
        "/flake\\.nix$/"
      ],
      "matchStrings": [
        "(?<depName>\\w+)\\.url = \"github:(?<packageName>[a-zA-Z-]+\/[a-zA-Z-]+)\/(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\";"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "A HyDE release changes the configs hydenix builds on, so someone reviews it before it lands",
      "matchDepNames": [
        "/^hyde-project\\/hyde$/i"
      ],
      "automerge": false
    },
    {
      "description": "Wait as long as the Dependabot cooldown before a release can update a pin",
      "matchDatasources": [
        "github-releases"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDepTypes": [
        "nix-raw-pkgs"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nix run .#update-hashes"
        ],
        "executionMode": "update",
        "fileFilters": [
          "pkgs/**/*.nix"
        ]
      }
    },
    {
      "matchDepTypes": [
        "nix-flake-inputs"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nix flake lock"
        ],
        "workingDirTemplate": "{{{packageFileDir}}}",
        "executionMode": "update",
        "fileFilters": [
          "**/flake.lock"
        ]
      }
    }
  ]
}