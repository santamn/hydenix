# ステータスバー waybar。
#
# HyDE は 80 個超のモジュール定義（jsonc）を持っており、
# それらをホームへ配置したうえで includes.json から参照させる構成になっている。
#
# style.css は wallbash が生成した配色を @import で読み込む。
# 利用者のカスタム CSS は userStyle オプション（→ user-style.css）に書く。
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.hydenix.hm.waybar;
in {
  options.hydenix.hm.waybar = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = config.hydenix.hm.enable;
      description = "Enable bar module";
    };

    waybar = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable waybar";
      };
    };

    userStyle = lib.mkOption {
      type = lib.types.lines;
      default = "";
      example = ''
        /* Custom waybar styles */
        window#waybar {
          background-color: rgba(0, 0, 0, 0.8);
        }
      '';
      description = "Custom CSS styles for waybar user-style.css";
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = with pkgs;
      lib.optionals cfg.waybar.enable [
        waybar # system bar
        playerctl # media player cli
        gobject-introspection # for python packages
        (python3.withPackages (ps: with ps; [pygobject3])) # python with pygobject3
        pyamdgpuinfo # AMD GPU information library
        lm_sensors # sensors information library
        power-profiles-daemon # power profiles daemon
      ];

    home.file = {
      # Modules for waybar
      # Note: some of these may not work for NixOS
      # TODO: review waybar modules for nix compatibility
      # 補足: HyDE のモジュール定義には Arch 前提のコマンドを呼ぶものが混じっており、
      # NixOS では動かないものがある。本家 TODO に「もう配置不要では」と残っている項目
      ".config/waybar/modules" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/modules";
        recursive = true;
        force = true;
      };
      ".config/waybar/layouts" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/layouts";
        recursive = true;
        force = true;
      };
      ".config/waybar/menus" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/menus";
        recursive = true;
        force = true;
      };
      ".config/waybar/styles" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/styles";
        recursive = true;
        force = true;
      };
      ".config/waybar/includes/border-radius.css" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/includes/border-radius.css";
        force = true;
        mutable = true;
      };
      ".config/waybar/includes/global.css" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/includes/global.css";
        force = true;
        mutable = true;
      };
      # waybar が読み込むモジュール定義の一覧。
      # HyDE のインストーラは `waybar.py --update` でこのファイルを書く。ここではそのうち
      # 書き出しを担う 2 つの関数だけをビルド時に実行し、~/.config/waybar/modules/ と
      # ~/.local/share/waybar/modules/ の両方を列挙させる。最後にビルド用のディレクトリを
      # xdg.configHome / xdg.dataHome に置き換える。
      # HyDE を更新してモジュールが増減すれば、このファイルも一緒に変わる。
      # flake.nix の checks.waybar-includes がこのビルドを CI で実行している
      ".config/waybar/includes/includes.json" = {
        # HyDE's install.sh writes this file with `waybar.py --update`, which also starts waybar; call only the two functions of --update that write it, over the module dirs home-manager deploys
        source =
          pkgs.runCommand "waybar-includes.json" {
            # importing waybar.py calls sys.exit(0) unless waybar is on PATH; waybar itself never runs here
            nativeBuildInputs = [pkgs.hyde.hydePython pkgs.waybar];
          } ''
            mkdir -p config/waybar data/waybar
            ln -s ${pkgs.hyde}/Configs/.config/waybar/modules config/waybar/modules
            ln -s ${pkgs.hyde}/Configs/.local/share/waybar/modules data/waybar/modules
            # waybar.py takes the include list from glob.glob, which keeps the filesystem's directory order; sort it so every builder writes the same file
            XDG_CONFIG_HOME=$PWD/config XDG_DATA_HOME=$PWD/data PYTHONPATH=${pkgs.hyde}/Configs/.local/lib/hyde python -c '
            import glob, waybar
            unsorted = glob.glob
            glob.glob = lambda pattern: sorted(unsorted(pattern))
            waybar.update_icon_size()
            waybar.generate_includes()
            '
            substitute config/waybar/includes/includes.json $out \
              --replace-fail "$PWD/config" "${config.xdg.configHome}" \
              --replace-fail "$PWD/data" "${config.xdg.dataHome}"
          '';
        force = true;
        mutable = true;
      };
      ".config/waybar/user-style.css" = {
        text = cfg.userStyle;
        force = true;
        mutable = true;
      };
      # wallbash が生成した配色（~/.cache/hyde/wallbash/gtk.css）と
      # theme.css / user-style.css を @import で読み込む。
      # 利用者のカスタム CSS は userStyle オプションに書けば user-style.css に入る
      ".config/waybar/style.css" = {
        text = ''
          /*!  DO NOT EDIT THIS FILE */
          /*
          *     ░▒▒▒░░░▓▓           ___________
          *   ░░▒▒▒░░░░░▓▓        //___________/
          *  ░░▒▒▒░░░░░▓▓     _   _ _    _ _____
          *  ░░▒▒░░░░░▓▓▓▓▓  | | | | |  | |  __/
          *   ░▒▒░░░░▓▓   ▓▓ | |_| | |_/ /| |___
          *    ░▒▒░░▓▓   ▓▓   |__  |____/ |____/
          *      ░▒▓▓   ▓▓  //____/
          */

          /* Modified by Hyde */
          /* Modify/add style in ~/.config/waybar/styles/ */
          @import "${config.xdg.dataHome}/waybar/styles/defaults.css";

          /* Imports wallbash colors */
          @import "${config.xdg.cacheHome}/hyde/wallbash/gtk.css";

          /* Colors and theme configuration is generated through the `theme.css` file */
          @import "theme.css";

          /* Users who want to override the current style add/edit 'user-style.css' */
          @import "user-style.css";
        '';
        force = true;
        mutable = true;
      };
      ".config/waybar/config.jsonc" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/config.jsonc";
        force = true;
        mutable = true;
      };
      ".config/waybar/theme.css" = {
        source = "${pkgs.hyde}/Configs/.config/waybar/theme.css";
        force = true;
      };
    };
  };
}
