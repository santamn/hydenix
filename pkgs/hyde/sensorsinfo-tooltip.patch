+def core_to_cpu_labels():
+    cpus = {}
+    for path in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/topology/core_id"):
+        cpu = int(re.search(r"cpu(\d+)/topology", path).group(1))
+        with open(path, encoding="utf-8") as f:
+            cpus.setdefault(f"Core {int(f.read())}", []).append(cpu)
+    return {core: "CPU " + ",".join(map(str, sorted(ids))) for core, ids in cpus.items()}
+
+
+def relabel_cores(data, labels):
+    renamed = {labels.get(sensor, sensor): values for sensor, values in data.items()}
+
+    def order(sensor):
+        match = re.match(r"CPU (\d+)", sensor)
+        return (1, int(match.group(1))) if match else (0, 0)
+
+    return dict(sorted(renamed.items(), key=lambda item: order(item[0])))
 
 
